# Deployed Spring Boot API URL (include the /api path)
# e.g., https://chatapp-backend.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# Deployed Spring Boot WebSocket URL (include the /ws path)
# e.g., https://chatapp-backend.onrender.com/ws
# For secure WebSockets (WSS), use wss:// or let SockJS resolve it over HTTPS
VITE_WS_URL=http://localhost:8080/ws
